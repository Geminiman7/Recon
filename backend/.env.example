# ============================================================================
# Recon backend - environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env` (see .gitignore).
# ============================================================================

# --- Application ---
APP_NAME=Recon
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
# SECRET_KEY must be set to a long random string (32+ bytes). Never use the default in production.
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Database ---
# Local dev (Step 4): use the docker-compose Postgres service
DATABASE_URL=postgresql+psycopg2://recon:recon@localhost:5432/recon

# --- Frontend / email ---
FRONTEND_URL=http://127.0.0.1:5500
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Auth hardening ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Billing (Paystack) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PRO_PLAN_CODE=
PAYSTACK_PRO_ANNUAL_PLAN_CODE=
PAYSTACK_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_DAYS=3

# --- Async worker (Step 8) ---
RECONCILIATION_MODE=async            # sync | async
# Optional. Leave empty to use PostgreSQL with app.workers.fallback_worker.
REDIS_URL=
REDIS_PROBE_INTERVAL=5
REDIS_RECOVERY_PROBES=2
FALLBACK_POLL_SECONDS=2
FALLBACK_GRACE_SECONDS=30

# --- Object storage (Step 9) ---
STORAGE_BACKEND=local               # local | s3
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# --- Observability (Step 13) ---
ENABLE_METRICS=true
SENTRY_DSN=

# --- Production ---
# Set these in your deployment environment. Never commit real secrets.
# SECRET_KEY must be a long random string in production.
# Configure SMTP_* for transactional emails (password reset, error alerts).
# DATABASE_URL should point to your managed Postgres instance.
