# Copy to .env on the production host and restrict it to the deploy user.
POSTGRES_USER=recon
POSTGRES_DB=recon
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
SECRET_KEY=replace-with-at-least-32-random-bytes
IMAGE_TAG=2026.09.03
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
FRONTEND_URL=https://recon.example.com
CORS_ORIGINS=https://recon.example.com
LOG_LEVEL=INFO


# API: replicas * processes * (pool + overflow).
API_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
WORKER_CONCURRENCY=2
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=0
DB_MAX_CONNECTIONS=100
API_TRUSTED_PROXY_CIDRS=172.30.0.0/24
BACKEND_SUBNET=172.30.0.0/24
API_CPUS=2
API_MEMORY=2g
WORKER_CPUS=2
WORKER_MEMORY=3g
DB_CPUS=2
DB_MEMORY=2g
REDIS_CPUS=0.5
REDIS_MEMORY=768m
FRONTEND_CPUS=0.5
FRONTEND_MEMORY=256m

# Set s3 BEFORE placing replicas on separate hosts; use workload IAM credentials.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_PREFIX=recon
S3_ENDPOINT_URL=
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_FILE_BYTES=104857600
MAX_SPREADSHEET_ROWS=200000
MAX_SPREADSHEET_COLUMNS=200
MAX_XLSX_EXPANDED_BYTES=268435456
EXPORT_MAX_ROWS=200000
EXPORT_MAX_BYTES=104857600
EXPORT_TTL_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PAYSTACK_SECRET_KEY=
PAYSTACK_PRO_PLAN_CODE=
PAYSTACK_PRO_ANNUAL_PLAN_CODE=
SENTRY_DSN=
