# Railway terminates public TLS. Keep the API private.
map $http_x_forwarded_proto $external_scheme {
    default $scheme;
    https https;
}
map $external_scheme $hsts {
    default "";
    https "max-age=31536000";
}

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

upstream recon_api {
    zone recon_api 64k;
    server ${API_HOST}:${API_PORT} resolve max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    client_max_body_size 101M;
    client_body_timeout 60s;
    send_timeout 60s;
    keepalive_timeout 30s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    add_header Strict-Transport-Security $hsts always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /landing.html {
        return 301 /$is_args$args;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1h;
        try_files $uri =404;
        access_log off;
    }

    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Strict-Transport-Security $hsts always;
    add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    location = /api { return 308 /api/; }

    location /api/ {
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security $hsts always;
        proxy_pass http://recon_api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Preserve the public API prefix on trailing-slash redirects.
        proxy_redirect ~^https?://[^/]+(/.*)$ /api$1;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @api_unavailable;
    }

    location = /health/live {
        access_log off;
        proxy_pass http://recon_api/health/live;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @api_unavailable;
    }

    # Nginx process liveness is deliberately independent of API readiness.
    location = /nginx-health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"alive","service":"nginx"}';
    }

    location = /health/ready {
        access_log off;
        proxy_pass http://recon_api/health/ready;
        proxy_connect_timeout 2s;
        proxy_read_timeout 7s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "30" always;
        return 503 '{"status":"unavailable","detail":"The service is temporarily unable to process this request. Please retry later."}';
    }
}
